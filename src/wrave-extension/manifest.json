{
  "manifest_version": 3,
  "name": "Wrave MCP server",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for Brave Browser to automate tabs, inspect DOM, and execute scripts.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/product_logo_16.png",
      "32": "icons/product_logo_32.png",
      "48": "icons/product_logo_48.png",
      "128": "icons/product_logo_128.png"
    },
    "default_title": "Wrave MCP server"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/product_logo_16.png",
    "32": "icons/product_logo_32.png",
    "48": "icons/product_logo_48.png",
    "128": "icons/product_logo_128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
