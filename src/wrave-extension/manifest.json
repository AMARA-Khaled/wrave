{
  "manifest_version": 3,
  "name": "Wrave - AI Browser Gateway",
  "version": "1.1.0",
  "description": "High-performance Model Context Protocol (MCP) browser gateway for Claude Code, Antigravity, and AI agents.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/product_logo_16.png",
      "32": "icons/product_logo_32.png",
      "48": "icons/product_logo_48.png",
      "128": "icons/product_logo_128.png"
    },
    "default_title": "Wrave MCP Gateway"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/product_logo_16.png",
    "32": "icons/product_logo_32.png",
    "48": "icons/product_logo_48.png",
    "128": "icons/product_logo_128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
